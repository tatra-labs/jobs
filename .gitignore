# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Parsed markdown (reproducible via process.py)
pages/

# Embeddings (unused in final visualization)
embed.py
embeddings.json

# macOS
.DS_Store

# Raw upstream downloads (large, reproducible via pipeline/fetch_*.py)
raw/

# Kaggle release: generated by pipeline/build_kaggle_dataset.py (~275MB).
# The docs are tracked; the data files are not.
kaggle/*.csv
kaggle/*.sqlite
