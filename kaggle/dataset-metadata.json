{
  "title": "US Remote Work & Tech Hiring, 2011-2026",
  "subtitle": "94,548 tech job postings, Census work-from-home rates and BLS employment",
  "description": "How remote work spread across the United States and what it did to technology hiring: every 'Ask HN: Who is hiring?' posting since 2011 parsed into structured fields, set against Census ACS work-from-home rates and BLS employment and wages. See README.md for the full data dictionary and the caveats that matter.",
  "id": "tatralabs/us-remote-work-and-tech-hiring-2011-2026",
  "licenses": [
    {
      "name": "CC-BY-4.0"
    }
  ],
  "keywords": [
    "business",
    "economics",
    "employment",
    "computer science",
    "internet"
  ],
  "resources": [
    {
      "path": "states.csv",
      "description": "US state / DC / Puerto Rico lookup: FIPS code, postal abbreviation, name.",
      "schema": {
        "fields": [
          {
            "name": "state_fips"
          },
          {
            "name": "state_abbr"
          },
          {
            "name": "state_name"
          }
        ]
      }
    },
    {
      "path": "hn_technologies.csv",
      "description": "The 112 technologies tracked in the Hacker News corpus, with the category used to group them and how many regex patterns define each one.",
      "schema": {
        "fields": [
          {
            "name": "technology_id"
          },
          {
            "name": "label"
          },
          {
            "name": "category"
          },
          {
            "name": "n_match_patterns"
          }
        ]
      }
    },
    {
      "path": "hn_roles.csv",
      "description": "The role taxonomy applied to each posting. A posting can carry several roles.",
      "schema": {
        "fields": [
